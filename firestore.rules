rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Customer Bookings Collection
    match /bookings/{bookingId} {
      // Allow visitors & customers to create and read service bookings
      allow create, read: if true;
      
      // Allow updates & deletion for authenticated users
      allow update, delete: if request.auth != null;
    }

    // Technician Roster Collection
    match /technicians/{techId} {
      // Allow public read of roster, authenticated updates
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
